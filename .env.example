# Chat backend configuration (Create React App reads REACT_APP_* at build time).
# Copy this file to .env and fill in the real values. .env is gitignored.

# CloudFront URL fronting the chat Lambda.
REACT_APP_AWS_ENDPOINT=<cloudfront-endpoint-url>

# API Gateway usage-plan key sent as the x-api-key header. Not a secret — it only
# binds traffic to a shared daily quota and ships in the public JS bundle.
# Re-fetch with:
#   aws apigateway get-api-key --api-key wt0s5tnka8 --include-value --region eu-west-2
REACT_APP_API_KEY=<api-gateway-usage-plan-key>
